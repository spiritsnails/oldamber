
say rom:PewterPokecenterJigglypuffText.Text
wait_text
lock_input on
music none
wait 32
music jigglypuff
face @1,3 down
wait 24
while music_playing
    face @1,3 left
    wait 24
    if not music_playing
        break
    end
    face @1,3 up
    wait 24
    if not music_playing
        break
    end
    face @1,3 right
    wait 24
    if not music_playing
        break
    end
    face @1,3 down
    wait 24
end

face @1,3 down
wait 48
music pokecenter
lock_input off
end
