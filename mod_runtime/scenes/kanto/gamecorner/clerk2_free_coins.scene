
if EVENT_GOT_20_COINS_2
    say rom:GameCornerClerk2Text.INeedMoreCoinsText
    wait_text
    stop
end
say rom:GameCornerClerk2Text.WantSomeCoinsText
wait_text
if not has_item(COIN_CASE)
    say rom:GameCornerOopsForgotCoinCaseText
    wait_text
    stop
end
if coins > 9990
    say rom:GameCornerClerk2Text.YouHaveLotsOfCoinsText
    wait_text
    stop
end
give_coins 20
set_event EVENT_GOT_20_COINS_2
sfx_on_print get_item
say rom:GameCornerClerk2Text.Received20CoinsText
wait_text
end
