
if EVENT_GOT_HITMONLEE
    say rom:FightingDojoBetterNotGetGreedyText
    wait_text
    stop
end
if EVENT_GOT_HITMONCHAN
    say rom:FightingDojoBetterNotGetGreedyText
    wait_text
    stop
end
show_dex MONSTER106
ask rom:FightingDojoHitmonleePokeBallText.Text
if answer is no
    stop
end
give_monster MONSTER106 30
wait_text
if party_full
    stop
end
set_event EVENT_GOT_HITMONLEE
set_event EVENT_DEFEATED_FIGHTING_DOJO
hide ball
sfx get_key_item
say rom:GotMonText badge=HITMONLEE
wait_text
ask rom:DoYouWantToNicknameText badge=HITMONLEE
if answer is yes
    name MONSTER106
end
if sent_to_box
    say rom:SentToBoxText
    wait_text
end
end
