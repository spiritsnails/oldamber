
lock_input on
spawn rocket ROCKET 9 11
say rom:PokemonTower7FRocket1AfterBattleText
wait_text
if player.y == 12 and player.x == 9
    queue rocket right 1
    queue rocket down 5
    queue rocket left 1
elif player.y == 11 and player.x == 10
    queue rocket down 1
    queue rocket right 1
    queue rocket down 4
else
    queue rocket down 5
end
march
despawn rocket
lock_input off
end
