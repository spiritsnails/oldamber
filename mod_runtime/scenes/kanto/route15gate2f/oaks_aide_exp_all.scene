
if EVENT_GOT_EXP_ALL
    say rom:Route15Gate2FOaksAideText.ExpAllText
    wait_text
    stop
end
ask rom:OaksAideHiText req=50 item=EXP.ALL
if answer is no
    say rom:OaksAideComeBackText req=50 item=EXP.ALL
    wait_text
    stop
end
let owned = dex_owned
if owned < 50
    say rom:OaksAideUhOhText req=50 item=EXP.ALL
    wait_text
    stop
end
say rom:OaksAideHereYouGoText
wait_text
give_item EXP_ALL
if bag_full
    say rom:OaksAideNoRoomText item=EXP.ALL
    wait_text
    stop
end
set_event EVENT_GOT_EXP_ALL
sfx_on_print get_item
say rom:OaksAideGotItemText item=EXP.ALL
wait_text
say rom:Route15Gate2FOaksAideText.ExpAllText
wait_text
end
