
lock_input on
say rom:ViridianMartClerkYouCameFromPalletTownText
wait_text
queue player up 2
queue player left 1
march

face @0,5 player
say rom:ViridianMartClerkParcelQuestText page=0-1
wait_text
give_item OAKS_PARCEL
set_event EVENT_GOT_OAKS_PARCEL

sfx_on_print get_key_item
say rom:ViridianMartClerkParcelQuestText page=2
wait_text
lock_input off
end
