
if EVENT_GOT_COIN_CASE
    say rom:CeladonDinerGymGuideText.WinItBackText
    wait_text
    stop
end
say rom:CeladonDinerGymGuideText.ImFlatOutBustedText
wait_text
give_item COIN_CASE
if bag_full
    say rom:CeladonDinerGymGuideText.CoinCaseNoRoomText
    wait_text
    stop
end
set_event EVENT_GOT_COIN_CASE
sfx_on_print get_key_item
say rom:CeladonDinerGymGuideText.ReceivedCoinCaseText
wait_text
end
