
if EVENT_GOT_LAPRAS
    if EVENT_BEAT_SILPH_CO_GIOVANNI
        say rom:SilphCo7FSilphWorkerM1Text.SavedText
        wait_text
        stop
    end
    say rom:SilphCo7FSilphWorkerM1Text.IsOurPresidentOkText
    wait_text
    stop
end
